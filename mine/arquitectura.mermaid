flowchart TD
    subgraph INGESTA [Ingesta - offline]
        direction LR
        OF[(OpenFing\nPlataforma)] -->|URLs y metadatos| SC[Scraper]
        SC -->|índice de videos| DL[Downloader]
        DL -->|archivos de audio| TR[Transcriber\nfaster-whisper]
        TR -->|texto + timestamps| EMB[Embeddings\nmultilingual-e5-base]
    end

    EMB -->|vectores| VDB[(PostgreSQL\n+ pgvector)]

    subgraph CONSULTA [Consulta - runtime]
        direction LR
        GEN[Generator\nLangChain + Llama 3.1 8B]
        UI[Chat UI]
        USER([Estudiante])
        USER -->|pregunta| UI
        UI -->|consulta| GEN
        GEN -->|respuesta + fuentes| UI
        UI -->|respuesta| USER
    end

    VDB -->|chunks relevantes| GEN

    style OF fill:#f5f5f5
    style VDB fill:#dbeafe
    style USER fill:#dcfce7

%% El pipeline tiene dos fases:
%% - Ingesta (fila superior): Scraper -> Downloader -> Transcriber -> Embeddings -> PostgreSQL/pgvector, corre offline para indexar todo el contenido de OpenFing.
%% - Consulta (fila inferior): el estudiante envia una pregunta, Generator recupera chunks relevantes de pgvector y el LLM genera una respuesta fundamentada con referencias a las clases fuente, que se retorna a la UI.
